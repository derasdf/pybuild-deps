{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    ":enableVulnerabilityAlerts",
    ":disableDependencyDashboard"
  ],
  "enabledManagers": ["github-actions", "pep621", "pre-commit"],
  // release-drafter buckets dependency PRs by the "dependencies" label;
  // dependabot added it automatically, Renovate needs it set explicitly.
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Weekly grouped GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "extends": ["schedule:weekly"],
      "groupName": "github-actions"
    },
    {
      "description": "Disable Python version updates in GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    // Disable only non-minor/patch types; disabling the whole manager stops
    // all updates including vulnerability-alert PRs.
    {
      "description": "Disable non-minor/patch Python updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": [
        "major",
        "pin",
        "pinDigest",
        "digest",
        "rollback",
        "bump",
        "replacement"
      ],
      "enabled": false
    },
    {
      "description": "Group Python minor and patch updates (pyproject.toml + uv.lock)",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies"
    }
  ]
}
